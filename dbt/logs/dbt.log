    create table "iceberg"."pg_silver"."cust_info_daily__dbt_tmp"
      comment 'Thông tin khách hàng & hợp đồng theo bút toán ngày (sheet CUST_INFO_DAILY) | SNAPSHOT | Silver Temp 1'
      WITH (partitioning = ARRAY['etl_date'])
    as (
      

WITH stmt AS (
    SELECT s.*
    FROM "iceberg"."pg_bronze"."smy_stmt_daily" AS s
    WHERE s.etl_date = DATE '2026-11-03'
      AND CAST(TRY(DATE_PARSE(NULLIF(TRIM(s.booking_date), ''), '%Y%m%d')) AS DATE) = DATE '2025-09-26'
),

m AS (
    SELECT *
    FROM (
        SELECT x.*,
               ROW_NUMBER() OVER (
                   PARTITION BY TRIM(x.contract_ref_no)
                   ORDER BY TRY_CAST(TRIM(x.version_no) AS DECIMAL(10)) DESC
               ) AS rn
        FROM "iceberg"."pg_bronze"."flexbo_pgb_ldtb_contract_master" AS x
        WHERE x.etl_date = DATE '2026-11-03'
    )
    WHERE rn = 1
),

td AS (
    SELECT x.*
    FROM "iceberg"."pg_bronze"."flexbo_pgb_los_contract_fields_tdate" AS x
    WHERE x.etl_date = DATE '2026-11-03'
      AND TRY_CAST(SUBSTR(TRIM(x.mov_date), 1, 10) AS DATE) = DATE '2025-09-26'
),

udf AS (
    SELECT x.*
    FROM "iceberg"."pg_bronze"."flexbo_pgb_contract_udf_map" AS x
    WHERE x.etl_date = DATE '2026-11-03'
),

udf_h AS (
    SELECT *
    FROM (
        SELECT x.*,
               ROW_NUMBER() OVER (
                   PARTITION BY TRIM(x.contract_ref_no)
                   ORDER BY TRY_CAST(SUBSTR(TRIM(x.mov_date), 1, 10) AS DATE) DESC
               ) AS rn
        FROM "iceberg"."pg_bronze"."flexbo_pgbld_contract_udfield_hist" AS x
        WHERE x.etl_date = DATE '2026-11-03'
          AND TRY_CAST(SUBSTR(TRIM(x.mov_date), 1, 10) AS DATE) <= DATE '2025-09-26'
    )
    WHERE rn = 1
),

rt_h AS (
    SELECT *
    FROM (
        SELECT x.*,
               ROW_NUMBER() OVER (
                   PARTITION BY TRIM(x.contract_ref_no)
                   ORDER BY TRY_CAST(SUBSTR(TRIM(x.mov_date), 1, 10) AS DATE) DESC
               ) AS rn
        FROM "iceberg"."pg_bronze"."flexbo_pgbld_rt_contract_udfield_hist" AS x
        WHERE x.etl_date = DATE '2026-11-03'
          AND TRY_CAST(SUBSTR(TRIM(x.mov_date), 1, 10) AS DATE) <= DATE '2025-09-26'
    )
    WHERE rn = 1
),

col_udf AS (
    SELECT x.*
    FROM "iceberg"."pg_bronze"."ebanking_col_udf_value" AS x
    WHERE x.etl_date = DATE '2026-11-03'
      AND TRIM(x.udf_id) = 'NHANNO_BATBUOC'
),

ld_los AS (
    SELECT x.*
    FROM "iceberg"."pg_bronze"."los_app_loan_disbursement" AS x
    WHERE x.etl_date = DATE '2026-11-03'
      AND TRIM(x.amnd_state) = 'F'
      AND TRIM(x.status) IN ('A', 'U')
),

fac AS (
    SELECT x.*
    FROM "iceberg"."pg_bronze"."los_app_facility" AS x
    WHERE x.etl_date = DATE '2026-11-03'
),

pd_los AS (
    SELECT x.*
    FROM "iceberg"."pg_bronze"."los_app_product" AS x
    WHERE x.etl_date = DATE '2026-11-03'
)

SELECT
    CAST(TRIM(col_udf.col_ref) AS VARCHAR)                                   AS col_ref,
    CAST(TRIM(col_udf.function_code) AS VARCHAR)                             AS function_code,
    CAST(TRIM(col_udf.udf_value) AS VARCHAR)                                 AS udf_value,
    CAST(TRIM(udf.contract_ref_no) AS VARCHAR)                               AS udf_map_contract_ref_no,
    CAST(TRIM(udf.field_name) AS VARCHAR)                                    AS field_name,
    CAST(TRIM(udf.field_val) AS VARCHAR)                                     AS field_val,
    TRY_CAST(SUBSTR(TRIM(m.booking_date), 1, 10) AS DATE)                    AS fcc_booking_date,
    CAST(TRIM(m.contract_ref_no) AS VARCHAR)                                 AS fcc_contract_ref_no,
    COALESCE(TRY_CAST(TRIM(m.version_no) AS DECIMAL(10, 0)), 0)              AS version_no,
    CAST(TRIM(td.can_bo_de_xuat_gn) AS VARCHAR)                              AS can_bo_de_xuat_gn,
    CAST(TRIM(td.car_application_code) AS VARCHAR)                           AS car_application_code,
    CAST(TRIM(td.contract_ref_no) AS VARCHAR)                                AS los_td_contract_ref_no,
    CAST(TRIM(td.los_contract_code) AS VARCHAR)                              AS los_contract_code,
    CAST(TRIM(td.mdvay_nkt) AS VARCHAR)                                      AS mdvay_nkt,
    CAST(TRIM(td.mdvay_sp) AS VARCHAR)                                       AS mdvay_sp,
