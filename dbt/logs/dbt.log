    create table "iceberg"."pg_silver"."ip_alt_identn__dbt_tmp"
      comment 'Giấy tờ định danh của khách hàng (sheet Involved Party Alternative Iden) | SCD TYPE 2 | Silver Temp 1'
      
    as (
      

WITH cus AS (
    SELECT c.*
    FROM "iceberg"."pg_bronze"."t24core_customer" AS c
    WHERE c.etl_date = DATE '2026-11-03'
      AND NULLIF(TRIM(c.recid), '') IS NOT NULL
),

src AS (
    SELECT
        CASE
        WHEN NULLIF(TRIM(c.recid), '') IS NULL THEN NULL
        ELSE LOWER(TO_HEX(MD5(TO_UTF8(CONCAT('T24_CUSTOMER', TRIM(c.recid))))))
    END AS cst_id,
        TRIM(c.recid)                             AS cst_code,
        TRIM(c.nat_id_type)                       AS identn_tp_code,
        CAST(TRY(DATE_PARSE(NULLIF(TRIM(c.nat_id_iss_date), ''), '%Y%m%d')) AS DATE)       AS identn_issu_dt,
        CAST(TRY(DATE_PARSE(NULLIF(TRIM(c.nat_id_exp_date), ''), '%Y%m%d')) AS DATE)       AS identn_expiry_dt,
        TRIM(c.nat_id_iss_plc)                    AS issu_plc_code,
        TRIM(c.national_id)                       AS identn_nbr
    FROM cus AS c
    WHERE NULLIF(TRIM(c.national_id), '') IS NOT NULL
),


cur AS (
    SELECT * FROM "iceberg"."pg_silver"."ip_alt_identn" WHERE sys_exp_dt IS NULL
),

new_ver AS (
    SELECT s.cst_id, s.cst_code, s.identn_tp_code, s.identn_issu_dt, s.identn_expiry_dt,
           s.issu_plc_code, s.identn_nbr,
           DATE '2026-11-03'   AS sys_eff_dt,
           CAST(NULL AS DATE) AS sys_exp_dt
    FROM src AS s
    LEFT JOIN cur AS c ON c.cst_id = s.cst_id
    WHERE c.cst_id IS NULL
       OR s.identn_tp_code IS DISTINCT FROM c.identn_tp_code
       OR s.identn_issu_dt IS DISTINCT FROM c.identn_issu_dt
       OR s.identn_expiry_dt IS DISTINCT FROM c.identn_expiry_dt
       OR s.issu_plc_code IS DISTINCT FROM c.issu_plc_code
       OR s.identn_nbr IS DISTINCT FROM c.identn_nbr
),

closed AS (
    SELECT c.cst_id, c.cst_code, c.identn_tp_code, c.identn_issu_dt, c.identn_expiry_dt,
           c.issu_plc_code, c.identn_nbr,
           c.sys_eff_dt,
           DATE '2026-11-03' AS sys_exp_dt
    FROM cur AS c
    LEFT JOIN src AS s ON s.cst_id = c.cst_id
    WHERE c.sys_eff_dt < DATE '2026-11-03'
      AND (
            (s.cst_id IS NULL AND EXISTS (SELECT 1 FROM cus))
         OR s.identn_tp_code IS DISTINCT FROM c.identn_tp_code
         OR s.identn_issu_dt IS DISTINCT FROM c.identn_issu_dt
         OR s.identn_expiry_dt IS DISTINCT FROM c.identn_expiry_dt
         OR s.issu_plc_code IS DISTINCT FROM c.issu_plc_code
         OR s.identn_nbr IS DISTINCT FROM c.identn_nbr
      )
),

final AS (
    SELECT * FROM new_ver
    UNION ALL
    SELECT * FROM closed
)


SELECT
    CAST(cst_id AS VARCHAR)         AS cst_id,
    CAST(cst_code AS VARCHAR)       AS cst_code,
    CAST(identn_tp_code AS VARCHAR) AS identn_tp_code,
    CAST(identn_issu_dt AS DATE)    AS identn_issu_dt,
    CAST(identn_expiry_dt AS DATE)  AS identn_expiry_dt,
    CAST(issu_plc_code AS VARCHAR)  AS issu_plc_code,
    CAST(identn_nbr AS VARCHAR)     AS identn_nbr,
    sys_eff_dt,
    sys_exp_dt,
    DATE '2026-11-03'                AS sys_udt_dt,
    DATE '2026-11-03'                AS etl_date
FROM final
    )
