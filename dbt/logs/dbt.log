    create table "iceberg"."pg_silver"."pd"
      comment 'Danh mục sản phẩm tín dụng (sheet Product) | SCD TYPE 1 | Silver Temp 1'
      
    as (
      

WITH los AS (
    SELECT
        TRIM(p.product_code) AS pd_code,
        TRIM(p.product_name) AS pd_nm,
        ROW_NUMBER() OVER (
            PARTITION BY TRIM(p.product_code)
            ORDER BY TRY_CAST(p.id AS BIGINT) DESC
        )                    AS rn
    FROM "iceberg"."pg_bronze"."los_app_product" AS p
    WHERE p.etl_date = DATE '2026-10-29'
),

pd_code AS (
    SELECT pd_code FROM los
    UNION
    SELECT TRIM(f.san_pham_cho_vay_khcn)
    FROM "iceberg"."pg_bronze"."flexbo_pgb_los_contract_fields_tdate" AS f
    WHERE f.etl_date = DATE '2026-10-29'
    UNION
    SELECT TRIM(f.san_pham_cho_vay_khdn)
    FROM "iceberg"."pg_bronze"."flexbo_pgb_los_contract_fields_tdate" AS f
    WHERE f.etl_date = DATE '2026-10-29'
    UNION
    SELECT TRIM(ld.productgr_code)
    FROM "iceberg"."pg_bronze"."t24core_ld_loans_and_deposits" AS ld
    WHERE ld.etl_date = DATE '2026-10-29'
),

src AS (
    SELECT
        CASE
        WHEN NULLIF(TRIM(c.pd_code), '') IS NULL THEN NULL
        ELSE LOWER(TO_HEX(MD5(TO_UTF8(CONCAT('T24_PRODUCT', TRIM(c.pd_code))))))
    END AS pd_id,
        c.pd_code,
        l.pd_nm
    FROM pd_code AS c
    LEFT JOIN los AS l ON l.pd_code = c.pd_code AND l.rn = 1
    WHERE NULLIF(c.pd_code, '') IS NOT NULL
),


final AS (
    SELECT
        pd_id, pd_code, pd_nm,
        DATE '2026-10-29'   AS sys_eff_dt,
        CAST(NULL AS DATE) AS sys_exp_dt
    FROM src
)


SELECT
    CAST(pd_id AS VARCHAR)         AS pd_id,
    CAST(pd_code AS VARCHAR)       AS pd_code,
    CAST(pd_nm AS VARCHAR)         AS pd_nm,
    CAST('T24_PRODUCT' AS VARCHAR) AS src_stm_code,
    sys_eff_dt,
    sys_exp_dt,
    DATE '2026-10-29'               AS sys_udt_dt,
    DATE '2026-10-29'               AS etl_date
FROM final
    )
