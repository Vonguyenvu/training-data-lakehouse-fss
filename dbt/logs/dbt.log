    CAST(TRY(DATE_PARSE(NULLIF(TRIM(ldh.value_date), ''), '%Y%m%d')) AS DATE)                                 AS ldh_value_date,
    CAST(TRIM(sch.contract_id) AS VARCHAR)                           AS contract_id,
    CAST(TRY(DATE_PARSE(NULLIF(TRIM(sch.prev_sched_date), ''), '%Y%m%d')) AS DATE)                            AS prev_sched_date,
    CAST(TRIM(mg.ld_id) AS VARCHAR)                                  AS ld_id,
