    create table "iceberg"."pg_silver"."sk_lich_tra_no__dbt_tmp"
      comment 'Staging lịch trả nợ kỹ thuật (sheet sk_lich_tra_no) | SNAPSHOT | Silver Temp 1. Grain: dòng PD_PAYMENT_DUE_MV x bút toán STMT_ENTRY trong ngày'
      WITH (partitioning = ARRAY['etl_date'])
    as (
      

WITH pdmv AS (
    SELECT x.*
    FROM "iceberg"."pg_bronze"."t24core_pd_payment_due_mv" AS x
    WHERE x.etl_date = DATE '2026-11-03'
      AND x.flag_status <> 'DELETE'
),

pd AS (
    SELECT * FROM (
        SELECT x.*, ROW_NUMBER() OVER (
                   PARTITION BY x.recid ORDER BY TRY_CAST(TRIM(x.curr_no) AS INTEGER) DESC) AS rn
        FROM "iceberg"."pg_bronze"."t24core_pd_payment_due" AS x
        WHERE x.etl_date = DATE '2026-11-03'
    ) WHERE rn = 1
),

pdhmv AS (
    SELECT * FROM (
        SELECT x.*, ROW_NUMBER() OVER (
                   PARTITION BY x.recid, x.pay_type ORDER BY TRY_CAST(TRIM(x.curr_no) AS INTEGER) DESC) AS rn
        FROM "iceberg"."pg_bronze"."t24core_pd_payment_due_his_mv" AS x
        WHERE x.etl_date = DATE '2026-11-03'
          AND x.flag_status = 'LIVE'
          AND TRY_CAST(TRIM(x.pay_amt_outs) AS DECIMAL(25, 5)) > 0
    ) WHERE rn = 1
),

pdh AS (
    SELECT * FROM (
        SELECT x.*, ROW_NUMBER() OVER (
                   PARTITION BY x.recid ORDER BY TRY_CAST(TRIM(x.curr_no) AS INTEGER) DESC) AS rn
        FROM "iceberg"."pg_bronze"."t24core_pd_payment_due_his" AS x
        WHERE x.etl_date = DATE '2026-11-03'
    ) WHERE rn = 1
),

sch AS (
    SELECT * FROM (
        SELECT x.*, ROW_NUMBER() OVER (
                   PARTITION BY x.contract_id ORDER BY CAST(TRY(DATE_PARSE(NULLIF(TRIM(x.prev_sched_date), ''), '%Y%m%d')) AS DATE) DESC) AS rn
        FROM "iceberg"."pg_bronze"."t24core_ld_schedule_define_mv" AS x
        WHERE x.etl_date = DATE '2026-11-03'
          AND CAST(TRY(DATE_PARSE(NULLIF(TRIM(x.prev_sched_date), ''), '%Y%m%d')) AS DATE) <= DATE '2025-10-07'
    ) WHERE rn = 1
),

ld AS (
    SELECT x.*
    FROM "iceberg"."pg_bronze"."t24core_ld_loans_and_deposits" AS x
    WHERE x.etl_date = DATE '2026-11-03'
),

ldh AS (
    SELECT * FROM (
        SELECT x.*, SPLIT_PART(x.recid, ';', 1) AS contract_code,
               ROW_NUMBER() OVER (
                   PARTITION BY SPLIT_PART(x.recid, ';', 1) ORDER BY TRY_CAST(TRIM(x.curr_no) AS INTEGER) DESC) AS rn
        FROM "iceberg"."pg_bronze"."t24core_ld_loans_and_deposits_his" AS x
        WHERE x.etl_date = DATE '2026-11-03'
    ) WHERE rn = 1
),

mg AS (
    SELECT * FROM (
        SELECT x.*, ROW_NUMBER() OVER (PARTITION BY x.ld_id ORDER BY x.productgr_code) AS rn
        FROM "iceberg"."pg_bronze"."t24core_mb_mg_saving_multi" AS x
        WHERE x.etl_date = DATE '2026-11-03'
    ) WHERE rn = 1
),

cus AS (
    SELECT x.recid, x.sector
    FROM "iceberg"."pg_bronze"."t24core_customer" AS x
    WHERE x.etl_date = DATE '2026-11-03'
),

sec AS (
    SELECT x.*
    FROM "iceberg"."pg_bronze"."t24core_sector" AS x
    WHERE x.etl_date = DATE '2026-11-03'
),

stmt AS (
    SELECT x.*
    FROM "iceberg"."pg_bronze"."t24core_stmt_entry" AS x
    WHERE x.etl_date = DATE '2026-11-03'
      AND CAST(TRY(DATE_PARSE(NULLIF(TRIM(x.booking_date), ''), '%Y%m%d')) AS DATE) = DATE '2025-10-07'
      AND x.commit_action <> 'D'
)

SELECT
    CAST(TRIM(ld.mb_rm_bancheo) AS VARCHAR)                          AS ld_mb_rm_bancheo,
    CAST(TRY(DATE_PARSE(NULLIF(TRIM(ld.orig_val_date), ''), '%Y%m%d')) AS DATE)                               AS ld_orig_val_date,
    COALESCE(TRY_CAST(TRIM(ld.pe_rate) AS DECIMAL(13, 7)), 0)        AS ld_pe_rate,
    CAST(TRIM(ld.prin_liq_acct) AS VARCHAR)                          AS ld_prin_liq_acct,
    CAST(TRIM(ld.productgr_code) AS VARCHAR)                         AS ld_productgr_code,
    COALESCE(TRY_CAST(TRIM(ld.ps_rate) AS DECIMAL(13, 7)), 0)        AS ps_rate,
    COALESCE(TRY_CAST(TRIM(ld.real_rate) AS DECIMAL(13, 7)), 0)      AS ld_real_rate,
    CAST(TRIM(ld.recid) AS VARCHAR)                                  AS ld_recid,
    CAST(TRIM(ld.record_status) AS VARCHAR)                          AS ld_record_status,
    CAST(TRIM(ld.status) AS VARCHAR)                                 AS status,
    CAST(TRIM(ld.use_of_loan) AS VARCHAR)                            AS ld_use_of_loan,
