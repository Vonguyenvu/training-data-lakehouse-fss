    CAST(TRIM(ldh.currency) AS VARCHAR)                              AS ldh_currency,
    CAST(TRIM(ldh.customer_id) AS VARCHAR)                           AS customer_id,
    CAST(TRY(DATE_PARSE(LPAD(NULLIF(TRIM(ldh.date_time), ''), 10, '0'), '%y%m%d%H%i')) AS DATE)                AS ldh_date_time,
