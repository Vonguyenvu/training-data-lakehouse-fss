[0m09:17:09.813072 [debug] [Thread-1 (]: On model.fss_training.ccy: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "fss_training", "target_name": "dev", "node_id": "model.fss_training.ccy"} */

  create or replace view
    "iceberg"."pg_silver"."ccy__dbt_tmp"
  security definer
  as
    

WITH src AS (
    SELECT
        CASE
        WHEN NULLIF(TRIM(cur.currency_code), '') IS NULL THEN NULL
        ELSE LOWER(TO_HEX(MD5(TO_UTF8(CONCAT('T24_CURRENCY', TRIM(cur.currency_code))))))
    END AS ccy_id,
        TRIM(cur.currency_code)                            AS ccy_code,
        TRIM(cur.ccy_name)                                 AS ccy_nm,
        TRIM(cur.numeric_ccy_code)                         AS numeric_ccy_code
    FROM "iceberg"."pg_bronze"."t24core_currency" AS cur
    WHERE cur.etl_date = DATE '2026-10-29'
      AND NULLIF(TRIM(cur.currency_code), '') IS NOT NULL
),


tgt AS (
    SELECT * FROM "iceberg"."pg_silver"."ccy"
),

changed AS (
    SELECT
        s.ccy_id, s.ccy_code, s.ccy_nm, s.numeric_ccy_code,
        COALESCE(t.sys_eff_dt, DATE '2026-10-29') AS sys_eff_dt,
        CAST(NULL AS DATE)                       AS sys_exp_dt
    FROM src AS s
    LEFT JOIN tgt AS t ON s.ccy_id = t.ccy_id
    WHERE t.ccy_id IS NULL
       OR t.sys_exp_dt IS NOT NULL
       OR s.ccy_nm IS DISTINCT FROM t.ccy_nm
       OR s.numeric_ccy_code IS DISTINCT FROM t.numeric_ccy_code
),

deleted AS (
    -- Chỉ đánh dấu xóa khi partition nguồn có dữ liệu, tránh expire toàn bộ khi Bronze chưa nạp.
    SELECT
        t.ccy_id, t.ccy_code, t.ccy_nm, t.numeric_ccy_code,
        t.sys_eff_dt,
        DATE '2026-10-29' AS sys_exp_dt
    FROM tgt AS t
    LEFT JOIN src AS s ON s.ccy_id = t.ccy_id
    WHERE s.ccy_id IS NULL
      AND t.sys_exp_dt IS NULL
      AND EXISTS (SELECT 1 FROM src)
),

final AS (
    SELECT * FROM changed
    UNION ALL
    SELECT * FROM deleted
)


SELECT
    CAST(ccy_id AS VARCHAR)           AS ccy_id,
    CAST(ccy_code AS VARCHAR)         AS ccy_code,
    CAST(ccy_nm AS VARCHAR)           AS ccy_nm,
    CAST(numeric_ccy_code AS VARCHAR) AS numeric_ccy_code,
    CAST('T24_CURRENCY' AS VARCHAR)   AS src_stm_code,
    sys_eff_dt,
    sys_exp_dt,
    DATE '2026-10-29'                  AS sys_udt_dt,
    DATE '2026-10-29'                  AS etl_date
FROM final
  
[0m09:17:09.820070 [debug] [Thread-1 (]: Opening a new connection, currently in state closed
