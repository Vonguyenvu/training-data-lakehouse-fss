[0m09:19:00.360302 [debug] [Thread-1 (]: On model.fss_training.ccy: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "fss_training", "target_name": "dev", "node_id": "model.fss_training.ccy"} */

  
    

    create table "iceberg"."pg_silver"."ccy__dbt_tmp"
      comment 'Danh mục tiền tệ (sheet Currency) | SCD TYPE 1 | Silver Temp 1'
      
    as (
      

WITH src AS (
    SELECT
        CASE
        WHEN NULLIF(TRIM(cur.currency_code), '') IS NULL THEN NULL
        ELSE LOWER(TO_HEX(MD5(TO_UTF8(CONCAT('T24_CURRENCY', TRIM(cur.currency_code))))))
    END AS ccy_id,
        TRIM(cur.currency_code)                            AS ccy_code,
        TRIM(cur.ccy_name)                                 AS ccy_nm,
        TRIM(cur.numeric_ccy_code)                         AS numeric_ccy_code
    FROM "iceberg"."pg_bronze"."t24core_currency" AS cur
    WHERE cur.etl_date = DATE '2026-10-29'
      AND NULLIF(TRIM(cur.currency_code), '') IS NOT NULL
),


tgt AS (
    SELECT * FROM "iceberg"."pg_silver"."ccy"
),

changed AS (
    SELECT
        s.ccy_id, s.ccy_code, s.ccy_nm, s.numeric_ccy_code,
        COALESCE(t.sys_eff_dt, DATE '2026-10-29') AS sys_eff_dt,
        CAST(NULL AS DATE)                       AS sys_exp_dt
    FROM src AS s
    LEFT JOIN tgt AS t ON s.ccy_id = t.ccy_id
    WHERE t.ccy_id IS NULL
       OR t.sys_exp_dt IS NOT NULL
       OR s.ccy_nm IS DISTINCT FROM t.ccy_nm
       OR s.numeric_ccy_code IS DISTINCT FROM t.numeric_ccy_code
),

deleted AS (
    -- Chỉ đánh dấu xóa khi partition nguồn có dữ liệu, tránh expire toàn bộ khi Bronze chưa nạp.
    SELECT
        t.ccy_id, t.ccy_code, t.ccy_nm, t.numeric_ccy_code,
        t.sys_eff_dt,
        DATE '2026-10-29' AS sys_exp_dt
    FROM tgt AS t
    LEFT JOIN src AS s ON s.ccy_id = t.ccy_id
    WHERE s.ccy_id IS NULL
      AND t.sys_exp_dt IS NULL
      AND EXISTS (SELECT 1 FROM src)
),

final AS (
    SELECT * FROM changed
    UNION ALL
    SELECT * FROM deleted
)


SELECT
    CAST(ccy_id AS VARCHAR)           AS ccy_id,
    CAST(ccy_code AS VARCHAR)         AS ccy_code,
    CAST(ccy_nm AS VARCHAR)           AS ccy_nm,
    CAST(numeric_ccy_code AS VARCHAR) AS numeric_ccy_code,
    CAST('T24_CURRENCY' AS VARCHAR)   AS src_stm_code,
    sys_eff_dt,
    sys_exp_dt,
    DATE '2026-10-29'                  AS sys_udt_dt,
    DATE '2026-10-29'                  AS etl_date
FROM final
    )
[0m09:19:00.360930 [debug] [Thread-2 (]: On model.fss_training.exg_rate: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "fss_training", "target_name": "dev", "node_id": "model.fss_training.exg_rate"} */

  
    

    create table "iceberg"."pg_silver"."exg_rate__dbt_tmp"
      comment 'Tỷ giá mid theo ngày (sheet Exchange Rate) | SNAPSHOT | Silver Temp 1'
      WITH (partitioning = ARRAY['etl_date'])
    as (
      

WITH cur AS (
    SELECT
        TRIM(cur.currency_code)                                                     AS frst_ccy_code,
        'VND'                                                                       AS scd_ccy_code,
        COALESCE(TRY_CAST(NULLIF(SPLIT_PART(cur.mid_reval_rate, '#', 1), '') AS DECIMAL(13, 7)), 1) AS mid_reval_rate,
        TRY(DATE_PARSE(LPAD(NULLIF(TRIM(cur.date_time), ''), 10, '0'), '%y%m%d%H%i'))                                         AS date_time_value,
        999999                                                                      AS curr_no,
        RANK() OVER (
            PARTITION BY TRIM(cur.currency_code)
            ORDER BY TRY(DATE_PARSE(LPAD(NULLIF(TRIM(cur.date_time), ''), 10, '0'), '%y%m%d%H%i')) DESC
        )                                                                           AS rn
    FROM "iceberg"."pg_bronze"."t24core_currency" AS cur
    WHERE cur.etl_date = DATE '2026-10-29'
      AND TRY(DATE_PARSE(LPAD(NULLIF(TRIM(cur.date_time), ''), 10, '0'), '%y%m%d%H%i')) < DATE '2026-10-29' + INTERVAL '1' DAY
),

cur_his AS (
    SELECT
        SPLIT_PART(ch.currency_code, ';', 1)                                        AS frst_ccy_code,
        'VND'                                                                       AS scd_ccy_code,
        COALESCE(TRY_CAST(NULLIF(SPLIT_PART(ch.mid_reval_rate, '#', 1), '') AS DECIMAL(13, 7)), 1) AS mid_reval_rate,
        TRY(DATE_PARSE(LPAD(NULLIF(TRIM(ch.date_time), ''), 10, '0'), '%y%m%d%H%i'))                                          AS date_time_value,
        TRY_CAST(ch.curr_no AS INTEGER)                                             AS curr_no,
        RANK() OVER (
            PARTITION BY SPLIT_PART(ch.currency_code, ';', 1)
            ORDER BY TRY(DATE_PARSE(LPAD(NULLIF(TRIM(ch.date_time), ''), 10, '0'), '%y%m%d%H%i')) DESC
        )                                                                           AS rn
    FROM "iceberg"."pg_bronze"."t24core_currency_his" AS ch
    WHERE ch.etl_date = DATE '2026-10-29'
      AND TRY(DATE_PARSE(LPAD(NULLIF(TRIM(ch.date_time), ''), 10, '0'), '%y%m%d%H%i')) < DATE '2026-10-29' + INTERVAL '1' DAY
),

cur_main AS (
    SELECT
        frst_ccy_code, scd_ccy_code, mid_reval_rate, date_time_value,
        RANK() OVER (PARTITION BY frst_ccy_code ORDER BY curr_no DESC) AS rnk
    FROM (
        SELECT * FROM cur WHERE rn = 1
        UNION ALL
        SELECT * FROM cur_his WHERE rn = 1
    )
)

SELECT
    DATE '2026-10-29'                          AS snpst_dt,
    CAST('T24_CURRENCY' AS VARCHAR)           AS src_stm_code,
    CAST(frst_ccy_code AS VARCHAR)            AS frst_ccy_code,
    CAST(scd_ccy_code AS VARCHAR)             AS scd_ccy_code,
    CAST(mid_reval_rate AS DECIMAL(25, 7))    AS mid_rate,
    DATE '2026-10-29'                          AS etl_date
FROM cur_main
WHERE rnk = 1
    )
