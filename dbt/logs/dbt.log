    create table "iceberg"."pg_silver"."ou"
      comment 'Danh mục đơn vị / chi nhánh (sheet Organization Unit) | SCD TYPE 1 | Silver Temp 1'
      
    as (
      

WITH src AS (
    SELECT
        CASE
        WHEN NULLIF(TRIM(ou.recid), '') IS NULL THEN NULL
        ELSE LOWER(TO_HEX(MD5(TO_UTF8(CONCAT('T24_COMPANY', TRIM(ou.recid))))))
    END AS ou_id,
        TRIM(ou.recid)                            AS ou_code,
        TRIM(ou.company_name)                     AS ou_nm
    FROM "iceberg"."pg_bronze"."t24core_company" AS ou
    WHERE ou.etl_date = DATE '2026-10-29'
      AND NULLIF(TRIM(ou.recid), '') IS NOT NULL
),


final AS (
    SELECT
        ou_id, ou_code, ou_nm,
        DATE '2026-10-29'   AS sys_eff_dt,
        CAST(NULL AS DATE) AS sys_exp_dt
    FROM src
)


SELECT
    CAST(ou_id AS VARCHAR)   AS ou_id,
    CAST(ou_code AS VARCHAR) AS ou_code,
    CAST(ou_nm AS VARCHAR)   AS ou_nm,
    sys_eff_dt,
    sys_exp_dt,
    DATE '2026-10-29'         AS sys_udt_dt,
    DATE '2026-10-29'         AS etl_date
FROM final
    )
