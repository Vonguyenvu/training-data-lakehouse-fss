    create table "iceberg"."pg_silver"."empe__dbt_tmp"
      comment 'Danh mục cán bộ / nhân viên (sheet Employee) | SCD TYPE 1 | Silver Temp 1'
      
    as (
      

WITH src AS (
    SELECT
        CASE
        WHEN NULLIF(TRIM(empe.recid), '') IS NULL THEN NULL
        ELSE LOWER(TO_HEX(MD5(TO_UTF8(CONCAT('T24_EMPLOYEE', TRIM(empe.recid))))))
    END AS empe_id,
        TRIM(empe.recid)                             AS empe_code,
        TRIM(empe.name)                              AS empe_nm
    FROM "iceberg"."pg_bronze"."t24core_dept_acct_officer" AS empe
    WHERE empe.etl_date = DATE '2026-11-03'
      AND NULLIF(TRIM(empe.recid), '') IS NOT NULL
),


tgt AS (
    SELECT * FROM "iceberg"."pg_silver"."empe"
),

changed AS (
    SELECT
        s.empe_id, s.empe_code, s.empe_nm,
        COALESCE(t.sys_eff_dt, DATE '2026-11-03') AS sys_eff_dt,
        CAST(NULL AS DATE)                       AS sys_exp_dt
    FROM src AS s
    LEFT JOIN tgt AS t ON s.empe_id = t.empe_id
    WHERE t.empe_id IS NULL
       OR t.sys_exp_dt IS NOT NULL
       OR s.empe_nm IS DISTINCT FROM t.empe_nm
),

deleted AS (
    -- Chỉ đánh dấu xóa khi partition nguồn có dữ liệu, tránh expire toàn bộ khi Bronze chưa nạp.
    SELECT
        t.empe_id, t.empe_code, t.empe_nm,
        t.sys_eff_dt,
        DATE '2026-11-03' AS sys_exp_dt
    FROM tgt AS t
    LEFT JOIN src AS s ON s.empe_id = t.empe_id
    WHERE s.empe_id IS NULL
      AND t.sys_exp_dt IS NULL
      AND EXISTS (SELECT 1 FROM src)
),

final AS (
    SELECT * FROM changed
    UNION ALL
    SELECT * FROM deleted
)


SELECT
    CAST(empe_id AS VARCHAR)   AS empe_id,
    CAST(empe_code AS VARCHAR) AS empe_code,
    CAST(empe_nm AS VARCHAR)   AS empe_nm,
    sys_eff_dt,
    sys_exp_dt,
    DATE '2026-11-03'           AS sys_udt_dt,
    DATE '2026-11-03'           AS etl_date
FROM final
    )
