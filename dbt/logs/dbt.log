      comment 'Địa chỉ liên lạc điện tử của khách hàng (sheet Involved Party Electronic Addre) | SCD TYPE 2 | Silver Temp 1'
      
    as (
      

WITH cus AS (
    SELECT c.*
    FROM "iceberg"."pg_bronze"."t24core_customer" AS c
    WHERE c.etl_date = DATE '2026-10-29'
      AND NULLIF(TRIM(c.recid), '') IS NOT NULL
),

src AS (
    SELECT CASE
        WHEN NULLIF(TRIM(recid), '') IS NULL THEN NULL
        ELSE LOWER(TO_HEX(MD5(TO_UTF8(CONCAT('T24_CUSTOMER', TRIM(recid))))))
    END AS cst_id, TRIM(recid) AS cst_code,
           'EMAIL' AS elc_adr_tp, TRIM(email_address) AS elc_adr_val
    FROM cus WHERE NULLIF(TRIM(email_address), '') IS NOT NULL
    UNION ALL
    SELECT CASE
        WHEN NULLIF(TRIM(recid), '') IS NULL THEN NULL
        ELSE LOWER(TO_HEX(MD5(TO_UTF8(CONCAT('T24_CUSTOMER', TRIM(recid))))))
    END, TRIM(recid),
           'HOME_NUMBER', TRIM(home_number)
    FROM cus WHERE NULLIF(TRIM(home_number), '') IS NOT NULL
    UNION ALL
    SELECT CASE
        WHEN NULLIF(TRIM(recid), '') IS NULL THEN NULL
        ELSE LOWER(TO_HEX(MD5(TO_UTF8(CONCAT('T24_CUSTOMER', TRIM(recid))))))
    END, TRIM(recid),
           'MOBILE_NUMBER', TRIM(mobile_number)
    FROM cus WHERE NULLIF(TRIM(mobile_number), '') IS NOT NULL
),


cur AS (
    SELECT * FROM "iceberg"."pg_silver"."ip_elc_adr" WHERE sys_exp_dt IS NULL
),

new_ver AS (
    -- Key mới, key xuất hiện lại (không còn dòng mở) hoặc giá trị đổi.
    SELECT s.cst_id, s.cst_code, s.elc_adr_tp, s.elc_adr_val,
           DATE '2026-10-29'   AS sys_eff_dt,
           CAST(NULL AS DATE) AS sys_exp_dt
    FROM src AS s
    LEFT JOIN cur AS c ON c.cst_id = s.cst_id AND c.elc_adr_tp = s.elc_adr_tp
    WHERE c.cst_id IS NULL
       OR s.elc_adr_val IS DISTINCT FROM c.elc_adr_val
),

closed AS (
    -- Đóng dòng đang mở khi giá trị đổi, hoặc key biến mất (chỉ khi partition nguồn có dữ liệu).
    -- sys_eff_dt = ETL_DATE (chạy lại cùng ngày) không đóng: new_ver ghi đè chính dòng đó.
    SELECT c.cst_id, c.cst_code, c.elc_adr_tp, c.elc_adr_val,
           c.sys_eff_dt,
           DATE '2026-10-29' AS sys_exp_dt
    FROM cur AS c
    LEFT JOIN src AS s ON s.cst_id = c.cst_id AND s.elc_adr_tp = c.elc_adr_tp
    WHERE c.sys_eff_dt < DATE '2026-10-29'
      AND (
            (s.cst_id IS NULL AND EXISTS (SELECT 1 FROM cus))
         OR s.elc_adr_val IS DISTINCT FROM c.elc_adr_val
      )
),

final AS (
    SELECT * FROM new_ver
    UNION ALL
    SELECT * FROM closed
)


SELECT
    CAST(cst_id AS VARCHAR)      AS cst_id,
    CAST(cst_code AS VARCHAR)    AS cst_code,
    CAST(elc_adr_tp AS VARCHAR)  AS elc_adr_tp,
    CAST(elc_adr_val AS VARCHAR) AS elc_adr_val,
    sys_eff_dt,
    sys_exp_dt,
    DATE '2026-10-29'             AS sys_udt_dt,
    DATE '2026-10-29'             AS etl_date
FROM final
    )
