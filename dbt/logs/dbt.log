    CAST(empe_code AS VARCHAR) AS empe_code,
    CAST(empe_nm AS VARCHAR)   AS empe_nm,
    sys_eff_dt,
    sys_exp_dt,
    DATE '2026-10-29'           AS sys_udt_dt,
    DATE '2026-10-29'           AS etl_date
FROM final
    )
